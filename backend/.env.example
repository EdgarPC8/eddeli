# Copiar a backend/.env y ajustar en servidor de producción.
# Nunca subir .env al repositorio.

# JWT — OBLIGATORIO en producción (cadena larga y aleatoria)
JWT_SECRET=cambiar-por-secreto-largo-en-produccion

# MySQL
DB_NAME=softed
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# Opcional: log SQL de Sequelize (1 = activo)
# DB_LOGGING=0

# Opcional: sync ALTER al arrancar (normalmente usar npm run db:sync)
# DB_SYNC_ALTER=0
