# Copiar a backend/.env y ajustar en servidor de producción.
# Nunca subir .env al repositorio.

# JWT — OBLIGATORIO en producción (cadena larga y aleatoria)
JWT_SECRET=cambiar-por-secreto-largo-en-produccion

# Opcional: clave aparte para cifrar la contraseña del certificado SRI (.p12).
# Si no se define, se usa JWT_SECRET.
# SRI_SECRET_KEY=otra-clave-larga-solo-servidor

# MySQL
DB_NAME=softed
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# Opcional: log SQL de Sequelize (1 = activo)
# DB_LOGGING=0

# Opcional: sync ALTER al arrancar (normalmente usar npm run db:sync)
# DB_SYNC_ALTER=0

# Entorno (production activa validaciones de seguridad estrictas)
# NODE_ENV=production

# Servidor HTTP
PORT=3001
API_PREFIX=eddeliapi

# Zona horaria por defecto si no está en panel de configuración (IANA)
# APP_TIMEZONE=America/Guayaquil

# Gestor central (solo para pull manual /admin; el runtime usa tabla local app_entitlements)
# Dev local: http://127.0.0.1:3000/raptorsolutions/api
# Producción: https://aplicaciones.marianosamaniego.edu.ec/raptorsolutions/api
SUBSCRIPTION_API_URL=http://127.0.0.1:3000/raptorsolutions/api

# Usado tanto para push (gestor → app) como para pull (app → gestor).
# Debe coincidir con Apps.entitlement_secret / EDDELI_ENTITLEMENT_SECRET del gestor
GESTOR_SYNC_SECRET=eddeli_gestor_sync_local_dev

# Webhook de eventos / métricas hacia Raptor Solutions
# Si no están, las métricas usan host/puerto de SUBSCRIPTION_API_URL.
# RAPTOR_WEBHOOK_HOST=127.0.0.1
# RAPTOR_WEBHOOK_PORT=3002
# RAPTOR_WEBHOOK_PROTOCOL=http
# RAPTOR_WEBHOOK_ENABLED=1
# RAPTOR_LOAD_METRICS_ENABLED=1
# RAPTOR_LOAD_METRICS_INTERVAL_SECONDS=10
