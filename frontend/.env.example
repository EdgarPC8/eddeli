# Copiar a frontend/.env y ajustar por instalación.
# Tras cambiar: reiniciar `npm run dev` o `npm run build`.

# Ruta pública del frontend (debe coincidir con Apache RewriteBase)
VITE_BASE_PATH=/eddeli/

# API backend (mismos valores que backend/.env)
VITE_API_PREFIX=eddeliapi
VITE_API_PORT=3001
VITE_API_HOST=192.168.3.40
VITE_API_ORIGIN=https://aplicaciones.marianosamaniego.edu.ec

# local = proxy Vite en dev | server = http://HOST:PORT | production = VITE_API_ORIGIN
VITE_API_MODE=local

# Carpeta img por defecto hasta cargar app_settings (sistema, negocio1, …)
VITE_MEDIA_PREFIX=sistema

# Suscripciones (opcional)
# VITE_SUBSCRIPTION_API_KEY=
# VITE_SUBSCRIPTIONS_ENABLED=
