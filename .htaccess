# SPA EdDeli bajo /eddeli/ — build en eddeli/dist/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /eddeli/

  # Archivos estáticos del build (dist/)
  RewriteCond dist/$1 -f [OR]
  RewriteCond dist/$1 -d
  RewriteRule ^(.+)$ dist/$1 [L]

  # Rutas React → index.html del build
  RewriteRule ^ dist/index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/wasm .wasm
</IfModule>
